{
  "name": "nashlo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/export-robots-config.js && node scripts/sync-robots-txt.js && node scripts/sync-indexnow-key.js && next build",
    "sync:robots": "node scripts/export-robots-config.js && node scripts/sync-robots-txt.js",
    "sync:indexnow": "node scripts/sync-indexnow-key.js",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "check:site-url:prod": "node scripts/check-production-site-url.js",
    "check:seo:prod": "node scripts/check-production-seo.js",
    "check:auth:prod": "node scripts/check-production-auth.js",
    "check:auth-payment-env": "node scripts/check-auth-payment-env.js",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:recover-migrations": "node scripts/recover-failed-migrations.js",
    "db:badges": "node scripts/ensure-badge-catalog.js",
    "db:badges:icons": "node scripts/update-badge-icons.js",
    "admin:create-owner": "tsx scripts/create-owner.ts",
    "db:backfill-slugs": "tsx scripts/backfill-listing-slugs.ts",
    "db:seed-want-to-buy": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
