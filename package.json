    "clsx": "^2.1.0",
    "date-fns": "^3.3.1",
    "ioredis": "^5.4.2",
    "jose": "^5.2.2",
    "lucide-react": "^0.323.0",
    "next": "14.1.0",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.50.1",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
