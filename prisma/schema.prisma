  title            String
  status           BusinessDealStatus @default(NEW)
  amount           Int?
  packageName      String?
  nextContactAt    DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([managerId, status])
  @@index([nextContactAt])
  @@index([businessClientId])
}

model BusinessNote {
  id               String          @id @default(cuid())
  businessClientId String
  businessClient   BusinessClient  @relation(fields: [businessClientId], references: [id], onDelete: Cascade)
  authorId         String?
  author           StaffAccount?   @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  text             String
  createdAt        DateTime        @default(now())

  @@index([businessClientId, createdAt(sort: Desc)])
  @@index([authorId])
}

enum PaidServiceType {
  BUMP        // поднятие в поиске
