  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model BusinessClient {
  id                String              @id @default(cuid())
  companyName       String
  inn               String?
  ogrn              String?
  category          String?
  contactName       String?
  phone             String?
  email             String?
  city              String?
  website           String?
  source            String?
