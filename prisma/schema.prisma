enum StaffRole {
  OWNER
  ADMIN
  MODERATOR
  SUPPORT
  BUSINESS_MANAGER
  B2B_MODERATOR
  FINANCE
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum BusinessClientStatus {
  NEW
  CONTACTED
  NEGOTIATING
  ACTIVE_CLIENT
  PAUSED
  LOST
}

enum BusinessDealStatus {
  NEW
  IN_PROGRESS
  WON
  LOST
  ON_HOLD
}

model StaffAccount {
  id             String      @id @default(cuid())
  login          String      @unique
  displayName    String?
  role           StaffRole
  status         StaffStatus @default(ACTIVE)
  codeHash       String
  codeChangedAt  DateTime    @default(now())
  failedAttempts Int         @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
