/// Настройки рекламного места: размеры, форматы, лимиты, цены, fallback
model AdPlacementConfig {
  id                 String                 @id @default(cuid())
  /// Код места: leaderboard | MOBILE_FEED_INLINE | siteBanner
  code               String                 @unique
  kind               AdPlacementKind
  name               String
  description        String?                @db.Text
  pages              String?
  whereOnPage        String?                @db.Text
  deviceScope        AdPlacementDeviceScope @default(ALL)
  designWidth        Int?
  designHeight       Int?
  displayWidth       Int?
  allowedFormats     String[]               @default([])
  maxFileBytes       Int?
  active             Boolean                @default(true)
  maxActiveCreatives Int                    @default(3)
  sortPriority       Int                    @default(0)
  pricePerMinute     Int?
  pricePerHour       Int?
  pricePerDay        Int?
  pricePerWeek       Int?
  fallbackTitle      String?
  fallbackSubtitle   String?
  fallbackCta        String?
  fallbackHref       String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([kind, active])
  @@index([sortPriority])
}

model AdCampaign {
  id                          String          @id @default(cuid())
  ownerId                     String?
  owner                       User?           @relation("UserAdCampaigns", fields: [ownerId], references: [id], onDelete: Cascade)
  title                       String
  description                 String?
  /// Legacy: если mediaUrl пуст, показ через resolveCampaignMedia как IMAGE
  imageUrl                    String?
  mediaType                   AdMediaType     @default(NONE)
  mediaUrl                    String?
  mediaPosterUrl              String?
  mediaAlt                    String?
  mediaWidth                  Int?
  mediaHeight                 Int?
  mediaDuration               Int?
  mediaSize                   Int?
  mediaMimeType               String?
  targetUrl                   String
  ctaText                     String?
  label                       String?
  city                        String?
  companyName                 String?
  phone                       String?
  type                        AdType          @default(NATIVE_CARD)
  placements                  AdPlacement[]
  status                      AdStatus        @default(DRAFT)
  categoryIds                 String[]        @default([])
  subcategoryIds              String[]        @default([])
  cityIds                     String[]        @default([])
  regionIds                   String[]        @default([])
  districtIds                 String[]        @default([])
  device                      AdDevice        @default(ALL)
  keywords                    String[]        @default([])
  interests                   String[]        @default([])
  startDate                   DateTime?
  endDate                     DateTime?
  pricingModel                AdPricingModel  @default(FIXED)
  budget                      Int?
  dailyBudget                 Int?
  spent                       Int             @default(0)
  maxImpressionsPerUserPerDay Int             @default(10)
  maxImpressionsPerSession    Int             @default(3)
  impressions                 Int             @default(0)
  clicks                      Int             @default(0)
  moderationNote              String?
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  events      AdEvent[]
  payments    AdPayment[]
  changeLogs  AdCampaignChangeLog[]

  @@index([status])
  @@index([ownerId, status])
  @@index([updatedAt(sort: Desc)])
}

model AdPayment {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation("UserAdPayments", fields: [userId], references: [id], onDelete: Cascade)
  adCampaignId      String
  adCampaign        AdCampaign       @relation(fields: [adCampaignId], references: [id], onDelete: Cascade)
  amount            Int
  currency          String           @default("RUB")
  status            AdPaymentStatus  @default(PENDING)
  provider          String           @default("internal")
  providerPaymentId String?
  createdAt         DateTime         @default(now())
  paidAt            DateTime?

  @@index([userId, createdAt(sort: Desc)])
  @@index([adCampaignId])
  @@index([status])
}

/// Веса честного ранжирования объявлений (редактируются в админке)
model ListingRankingSettings {
  id        String   @id @default("default")
  weights   Json
  updatedAt DateTime @updatedAt
}

model AdCampaignChangeLog {
  id           String     @id @default(cuid())
  adCampaignId String
  adCampaign   AdCampaign @relation(fields: [adCampaignId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation("UserAdCampaignChanges", fields: [userId], references: [id], onDelete: SetNull)
  action       String
  oldValue     Json?
  newValue     Json?
  createdAt    DateTime   @default(now())

  @@index([adCampaignId, createdAt(sort: Desc)])
}

model AdEvent {
  id           String       @id @default(cuid())
  adId         String
  ad           AdCampaign   @relation(fields: [adId], references: [id], onDelete: Cascade)
  userId       String?
  sessionId    String?
  eventType    AdEventType
  placement    AdPlacement?
  categoryId   String?
  cityId       String?
  device       AdDevice?
  createdAt    DateTime     @default(now())

  @@index([adId, eventType, createdAt(sort: Desc)])
  @@index([adId, userId, eventType, createdAt(sort: Desc)])
  @@index([adId, sessionId, eventType, createdAt(sort: Desc)])
  @@index([sessionId, createdAt(sort: Desc)])
}

