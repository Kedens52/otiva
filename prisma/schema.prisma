generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum ProfileType {
  PERSON
  COMPANY
}

enum ListingStatus {
  ACTIVE
  SOLD
  ARCHIVED
  MODERATION
  REJECTED
}

enum MessageStatus {
  SENT
  READ
}

enum ConversationType {
  PERSONAL
  BUSINESS
  SUPPORT
}

enum ConversationContextType {
  LISTING
  BUSINESS_LISTING
  BUSINESS_REQUEST
  BUSINESS_INQUIRY
  SUPPORT_TICKET
  DIRECT
}

enum MessageSenderType {
  USER
  COMPANY
  SUPPORT
}

enum SupportWorkflowStatus {
  ACTIVE
  WAITING_USER
  WAITING_OPERATOR
  RESOLVED_AUTO
  CLOSED
}

enum ModerationAction {
  APPROVED
  REJECTED
  FLAGGED
}

enum NotificationType {
  NEW_MESSAGE
  LISTING_APPROVED
  LISTING_REJECTED
  LISTING_SOLD
  NEW_REVIEW
  PAYMENT_SUCCESS
  PROMOTION_EXPIRING
  WANT_TO_BUY_NEW_OFFER
  WANT_TO_BUY_OFFER_ACCEPTED
  WANT_TO_BUY_OFFER_DECLINED
  WANT_TO_BUY_EXPIRING_SOON
  WANT_TO_BUY_REJECTED
}

enum BadgeCode {
  BEGINNER
  FIRST_STEP
  VERIFIED
  ACTIVE
  TRUSTED
  PRO
  SAFE_DEAL
  PREMIUM
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REPORTED
  DELETED
  REJECTED
}

enum DealStatus {
  PENDING
  COMPLETED
  CANCELLED
  DISPUTED
}

/// Баллы Нашло — начисление / списание
enum BonusTransactionType {
  EARN
  SPEND
  ADJUST
  REVERSAL
}

enum BonusTransactionStatus {
  PENDING
  APPROVED
  REJECTED
  REVERSED
}

enum BonusReason {
  WELCOME
  PHONE_VERIFIED
  PROFILE_COMPLETE
  AVATAR_ADDED
  FIRST_QUALITY_LISTING
  QUALITY_LISTING
  SHARE_VK
  SHARE_MAX
  FAST_RESPONSE_DAY
  DEAL_COMPLETED
  REVIEW_LEFT
  POSITIVE_REVIEW_RECEIVED
  REFERRAL_REGISTERED
  REFERRAL_ACTIVE
  SPEND_BUMP
  SPEND_HIGHLIGHT
  SPEND_RECOMMENDATIONS
  SPEND_AUTOBOOST
  SPEND_PROMO_DISCOUNT
  ADMIN_ADJUST
  REVERSAL
}

enum SharePlatform {
  VK
  MAX
}

enum ReferralStatus {
  PENDING
  ACTIVE
  REJECTED
}

/// Заявка покупателя «Куплю»
enum WantToBuyStatus {
  ACTIVE
  CLOSED
  EXPIRED
  MODERATION
  REJECTED
}

enum WantToBuyCondition {
  NEW
  USED
  ANY
}

/// Статус отклика продавца на заявку (OfferStatus в коде приложения)
enum WantToBuyOfferStatus {
  PENDING
  VIEWED
  ACCEPTED
  DECLINED
}

model User {
  id          String   @id @default(cuid())
  phone       String?  @unique
  email       String?  @unique
  vkId        String?  @unique
  yandexId    String?  @unique
  name        String?
  firstName   String?
  lastName    String?
  avatar      String?
  description String?
  city        String?
  role        Role     @default(USER)
  isVerified  Boolean  @default(false)
  isBanned    Boolean  @default(false)
  walletBalance Int    @default(0)
  /// Баллы Нашло (не выводятся, только внутри сайта)
  bonusBalance  Int    @default(0)
  bonusBlocked  Boolean @default(false)
  /// Реферальный код для приглашений
  referralCode  String?  @unique
  rating      Float    @default(0)
  reviewCount          Int      @default(0)
  positiveReviewsCount Int      @default(0)
  neutralReviewsCount  Int      @default(0)
  negativeReviewsCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Расширения профиля
  profileType      ProfileType @default(PERSON)
  profileHeadline  String?
  region           String?
  district         String?
  metro            String?
  addressNote      String?
  sellerRole       String?
  businessCategory String?
  experience       String?
  serviceArea      String?
  deliveryOptions  String[]  @default([])
  guaranteeText    String?
  companyRole      String?
  vkUrl            String?
  maxUrl           String?
  websiteUrl       String?
  showPhonePublicly    Boolean @default(false)
  showEmailPublicly    Boolean @default(false)
  showCityPublicly     Boolean @default(true)
  showDistrictPublicly Boolean @default(true)
  showActivityPublicly Boolean @default(true)
  showBadgesPublicly   Boolean @default(true)
  showReviewsPublicly  Boolean @default(true)
  companyName      String?
  companyInn       String?
  companyWebsite   String?
  emailVerified    Boolean  @default(false)
  emailVerifiedAt  DateTime?
  phoneVerifiedAt  DateTime?
  /// Показывать номер покупателям (по кнопке «Показать номер»)
  showPhone        Boolean  @default(false)
  /// Последняя активность (для значка ACTIVE)
  lastSeenAt       DateTime?
  /// Премиум-профиль до даты
  premiumUntil     DateTime?
  /// Безопасная сделка включена
  safeDealEnabled  Boolean  @default(false)
  /// Ручная проверка Нашло (для PRO)
  manuallyVerified Boolean  @default(false)
  /// ЧПУ публичного профиля продавца
  publicSlug       String?  @unique
  lastLoginAt      DateTime?
  lastLoginIp      String?
  notificationSettings Json?

  trustTier           String @default("NORMAL")
  internalTrustScore  Float  @default(50)
  riskPenaltyScore    Float  @default(0)
  avgResponseMinutes  Int?
  /// Человекочитаемые плюсы TrustScore (последний пересчёт), только для админки
  trustReasons        Json?
  /// Человекочитаемые факторы RiskScore (последний пересчёт), только для админки
  riskReasons         Json?
  lastTrustCalculatedAt DateTime?
  /// Мягкое ограничение с админки: часть действий требуют проверки
  accountRestricted   Boolean @default(false)

  listings             Listing[]
  trustEvents          UserTrustEvent[]
  sentMessages         Message[]          @relation("SentMessages")
  conversationMembers  ConversationMember[]
  moderationLogs       ModerationLog[] @relation("UserModerationLogs")
  reviews              Review[]           @relation("ReviewsReceived")
  reviewsGiven         Review[]           @relation("ReviewsGiven")
  dealsAsSeller        Deal[]             @relation("DealSeller")
  dealsAsBuyer         Deal[]             @relation("DealBuyer")
  reviewReports        ReviewReport[]     @relation("ReviewReporter")
  favorites            Favorite[]
  otpCodes             OtpCode[]
  walletTransactions   WalletTransaction[]
  bonusTransactions    BonusTransaction[]
  bonusShareEvents     BonusShareEvent[]    @relation("UserBonusShares")
  referralsMade        Referral[]           @relation("ReferrerUser")
  referralReceived     Referral?            @relation("ReferredUser")
  payments             Payment[]
  pushSubscriptions    PushSubscription[]
  notifications        Notification[]
  sessions             Session[]
  paidServices         PaidService[]
  legalConsents        LegalConsent[]
  cookieConsentEvents  CookieConsentEvent[]
  reportsAgainst       Report[]         @relation("ReportTargetUser")
  siteVisits           SiteVisit[]
  userBadges           UserBadge[]
  adCampaigns          AdCampaign[]       @relation("UserAdCampaigns")
  adPayments           AdPayment[]        @relation("UserAdPayments")
  adCampaignChanges    AdCampaignChangeLog[] @relation("UserAdCampaignChanges")
  ownedCompanies       Company[]          @relation("CompanyOwner")
  companyMemberships   CompanyMember[]
  businessInquiriesSent BusinessInquiry[] @relation("BusinessInquiryFromUser")
  companyReviewsAuthored CompanyReview[]  @relation("CompanyReviewsAuthored")
  wantToBuys             WantToBuy[]
  sellerOffers           WantToBuyOffer[] @relation("WantToBuySellerOffers")
  contentModerationIncidents ContentModerationIncident[]
  uploadedMediaFingerprints  UploadedMediaFingerprint[]

  @@index([phone])
  @@index([premiumUntil])
  @@index([role])
  @@index([trustTier])
}

model Badge {
  id          String    @id @default(cuid())
  code        BadgeCode @unique
  title       String
  subtitle    String
  description String
  icon        String
  priority    Int
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userBadges  UserBadge[]
}

model UserBadge {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  issuedAt  DateTime  @default(now())
  expiresAt DateTime?
  issuedBy  String    @default("system")
  reason    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@index([expiresAt])
}

model UserTrustEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  scoreDelta Int?
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// Активные сессии пользователя (для раздела Безопасность)
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  userAgent    String?
  ip           String?
  device       String?  // "iPhone, Safari" — парсим из UA
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

model WalletTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  status    String   @default("COMPLETED")
  amount    Int
  balanceAfter Int
  title     String
  listingId String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model BonusTransaction {
  id           String                 @id @default(cuid())
  userId       String
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         BonusTransactionType
  status       BonusTransactionStatus @default(APPROVED)
  reason       BonusReason
  amount       Int
  balanceAfter Int
  /// Уникальный ключ события (listingId, dealId, share:listing:VK и т.д.)
  referenceKey String?
  listingId    String?
  metadata     Json?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([userId, reason, referenceKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([reason])
}

model BonusShareEvent {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation("UserBonusShares", fields: [userId], references: [id], onDelete: Cascade)
  listingId  String
  platform   SharePlatform
  createdAt  DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([listingId, platform])
}

model Referral {
  id             String         @id @default(cuid())
  referrerId     String
  referrer       User           @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId String         @unique
  referredUser   User           @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  status         ReferralStatus @default(PENDING)
  activatedAt    DateTime?
  createdAt      DateTime       @default(now())

  @@index([referrerId])
  @@index([status])
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  CANCELED
  FAILED
  REFUNDED
  PARTIAL_REFUNDED
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  tbankPaymentId String?       @unique
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId      String?
  listing        Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  serviceType    String
  amount         Int
  status         PaymentStatus @default(PENDING)
  paymentUrl     String?
  raw            Json?
  paidAt         DateTime?
  canceledAt     DateTime?
  refundedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  events         PaymentEvent[]

  @@index([userId])
  @@index([listingId])
  @@index([status])
}

model PaymentEvent {
  id              String   @id @default(cuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  providerEventId String?
  rawEventHash    String
  status          String
  payload         Json
  createdAt       DateTime @default(now())

  @@unique([paymentId, rawEventHash])
  @@index([paymentId, createdAt(sort: Desc)])
  @@index([providerEventId])
}

model SiteBanner {
  id        String   @id @default(cuid())
  title     String
  linkText  String?
  href      String   @default("/")
  image     String?  @db.Text
  imageOnly Boolean  @default(false)
  bgFrom    String   @default("#bbf7d0")
  bgTo      String   @default("#bae6fd")
  active          Boolean  @default(false)
  disclosureMark  String?  @default("ad")  // "ad" | "partner"
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active])
  @@index([createdAt])
}

enum BannerSlotId {
  leaderboard
  mobileLeaderboard
  sidebarTop
  sidebarTall
  listingSidebar
}

enum BannerSlotAdStatus {
  draft
  pending
  approved
  rejected
}

/// Пометка в углу баннера: «Реклама» или «Партнёр сервиса»
enum BannerAdDisclosureMark {
  ad
  partner
}

model BannerSlotAd {
  id                String             @id @default(cuid())
  slot              BannerSlotId
  title             String
  subtitle          String
  cta               String
  href              String
  image             String?            @db.Text
  mediaType         AdMediaType        @default(IMAGE)
  mediaMimeType     String?
  mediaWidth        Int?
  mediaHeight       Int?
  mediaDuration     Int?
  advertiser        String
  disclosureMark    BannerAdDisclosureMark @default(ad)
  active            Boolean            @default(false)
  startsAt          DateTime           @db.Date
  endsAt            DateTime           @db.Date
  erid              String
  ordName           String
  ownerEmail        String?
  ownerName         String?
  status            BannerSlotAdStatus @default(draft)
  moderationComment String?
  impressions       Int                @default(0)
  clicks            Int                @default(0)
  lastImpressionAt  DateTime?
  lastClickAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([slot, active])
  @@index([updatedAt])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  nameRu      String
  icon        String?
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  seoTitle       String?
  seoDescription String?
  h1             String?
  seoText        String?
  canonicalUrl   String?
  indexable      Boolean  @default(true)
  sitemapPriority Float   @default(0.7)
  sitemapChangefreq String @default("weekly")
  listings    Listing[]
  wantToBuys  WantToBuy[]

  @@index([slug])
  @@index([indexable])
}

/// SEO-лендинги популярных запросов (/s/slug)
model SeoLanding {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  seoTitle        String?
  seoDescription  String?
  h1              String?
  seoText         String?
  canonicalUrl    String?
  indexable       Boolean  @default(true)
  categorySlug    String?
  internalCategorySlug String?
  city            String?
  fixedParams     Json?
  sitemapPriority Float    @default(0.7)
  sitemapChangefreq String @default("weekly")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([indexable])
}

model Listing {
  id          String        @id @default(cuid())
  /// ЧПУ для URL: title-city-id
  slug        String?       @unique
  title       String
  description String
  price       Int
  currency    String        @default("RUB")
  status      ListingStatus @default(MODERATION)
  images      String[]
  location    String?
  city        String?
  district    String?
  video       String?
  lat         Float?
  lng         Float?
  showExactAddress Boolean  @default(false)
  views           Int           @default(0)
  uniqueViews     Int           @default(0)
  rejectionReason String?
  /// Код причины из справочника модерации (WRONG_CATEGORY и т.п.)
  moderationReasonCode String?
  /// Нормализованный отпечаток title+description (дедупликация)
  contentFingerprint   String?
  /// Отправлено на доработку продавцом после решения модератора
  returnedForRevision Boolean       @default(false)
  /// Недвижимость: последнее подтверждение актуальности
  freshnessConfirmedAt DateTime?
  autoApproved    Boolean       @default(false)
  isPromoted     Boolean       @default(false)
  promotedUntil  DateTime?
  highlightedUntil DateTime?
  recommendedUntil DateTime?
  autoboostUntil DateTime?
  pinnedUntil    DateTime?

  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])

  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  // Category-specific attributes stored as JSON
  attributes  Json?

  conversations Conversation[]
  moderationLogs ModerationLog[]
  contentIncidents ContentModerationIncident[]
  favorites     Favorite[]
  reports       Report[]
  payments      Payment[]
  paidServices  PaidService[]
  listingViews  ListingView[]
  reviews       Review[]
  deals         Deal[]
  priceInsight  ListingPriceInsight?
  wantToBuyOffers WantToBuyOffer[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
  @@index([sellerId])
  @@index([sellerId, contentFingerprint])
  @@index([contentFingerprint])
  @@index([status])
  @@index([city])
  @@index([district])
  @@index([price])
  @@index([createdAt])
}

/// Заявка покупателя «Куплю» (обратный маркетплейс)
model WantToBuy {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  description          String             @default("")
  categoryId           String
  category             Category           @relation(fields: [categoryId], references: [id])
  priceMax             Int?
  city                 String?
  condition            WantToBuyCondition @default(ANY)
  status               WantToBuyStatus    @default(MODERATION)
  views                Int                @default(0)
  expiresAt            DateTime
  rejectionReason      String?
  moderationReasonCode String?
  autoApproved         Boolean            @default(false)
  contentFingerprint   String?
  /// Напоминание «истекает через 3 дня» уже отправлено
  expiringSoonNotifiedAt DateTime?
  offers               WantToBuyOffer[]
  contentIncidents     ContentModerationIncident[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([userId, status])
  @@index([userId, contentFingerprint])
  @@index([contentFingerprint])
  @@index([status, createdAt])
  @@index([categoryId])
  @@index([city])
  @@index([expiresAt])
  @@index([priceMax])
}

/// Отклик продавца на заявку «Куплю»
model WantToBuyOffer {
  id          String               @id @default(cuid())
  wantToBuyId String
  wantToBuy   WantToBuy            @relation(fields: [wantToBuyId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      User                 @relation("WantToBuySellerOffers", fields: [sellerId], references: [id], onDelete: Cascade)
  message     String
  price       Int
  listingId   String?
  listing     Listing?             @relation(fields: [listingId], references: [id], onDelete: SetNull)
  status      WantToBuyOfferStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([wantToBuyId, sellerId])
  @@index([wantToBuyId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
}

/// Оценка рыночной цены при создании/редактировании объявления
model ListingPriceInsight {
  id         String   @id @default(cuid())
  listingId  String   @unique
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  status     String
  min        Int?
  max        Int?
  median     Int?
  p25        Int?
  p75        Int?
  sampleSize Int      @default(0)
  confidence String?
  message    String?
  /// Причина низкой цены от продавца (срочная продажа, дефекты и т.д.)
  reason     String?
  checkedAt  DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([checkedAt])
}

model Conversation {
  id        String   @id @default(cuid())
  conversationType ConversationType @default(PERSONAL)
  contextType      ConversationContextType @default(DIRECT)
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company? @relation("CompanyConversations", fields: [companyId], references: [id], onDelete: SetNull)
  businessListingId String?
  businessListing   BusinessListing? @relation(fields: [businessListingId], references: [id], onDelete: SetNull)
  businessRequestId String?
  businessRequest   BusinessRequest? @relation(fields: [businessRequestId], references: [id], onDelete: SetNull)
  businessInquiryId String? @unique
  businessInquiry   BusinessInquiry? @relation(fields: [businessInquiryId], references: [id], onDelete: SetNull)
  isSupport Boolean  @default(false)

  /// Состояние обращения в чате поддержки (для isSupport = true)
  supportWorkflowStatus SupportWorkflowStatus @default(ACTIVE)
  operatorNeeded        Boolean               @default(false)
  lastAutoReplyCatalogId String?
  /// HELPFUL | ESCALATED — реакция пользователя на последний автоответ
  lastAutoReplyAction    String?
  /// Тема обращения в поддержке (см. src/lib/support/topics.ts)
  supportTopic           String?
  supportSubtopic        String?
  supportListingId       String?
  supportAdCampaignId    String?
  supportPriority        String?  @default("normal")
  /// Состояние сценария бота (JSON)
  supportBotState        Json?

  members   ConversationMember[]
  messages  Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([companyId])
  @@index([businessListingId])
  @@index([conversationType])
  @@index([isSupport])
  @@index([supportWorkflowStatus])
}

/// Шаблоны быстрых ответов оператора поддержки (/admin/support)
model SupportOperatorQuickReply {
  id               String   @id @default(cuid())
  title            String
  category         String
  body             String   @db.Text
  tags             String[] @default([])
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)
  isFavorite       Boolean  @default(false)
  usageCount       Int      @default(0)
  createdByStaffId String?
  updatedByStaffId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  usageLogs SupportQuickReplyUsage[]

  @@index([category, active, sortOrder])
  @@index([active, isFavorite])
}

/// История использования быстрых ответов оператором
model SupportQuickReplyUsage {
  id             String   @id @default(cuid())
  quickReplyId   String
  quickReply     SupportOperatorQuickReply @relation(fields: [quickReplyId], references: [id], onDelete: Cascade)
  conversationId String
  staffId        String
  wasEdited      Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([quickReplyId, createdAt(sort: Desc)])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([staffId, createdAt(sort: Desc)])
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  text           String
  images         String[]
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderType     MessageSenderType @default(USER)
  senderCompanyId String?
  status         MessageStatus @default(SENT)
  /// JSON: автоответы и служебные сообщения поддержки (см. src/lib/support/payload.ts)
  supportPayload Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([senderCompanyId])
}

model ModerationLog {
  id        String           @id @default(cuid())
  listingId String
  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  moderatorId String?
  moderator User?            @relation("UserModerationLogs", fields: [moderatorId], references: [id], onDelete: SetNull)
  staffId   String?
  staff     StaffAccount?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  action    ModerationAction
  reason    String?
  createdAt DateTime         @default(now())

  @@index([listingId])
  @@index([moderatorId])
  @@index([staffId])
}

model Review {
  id             String        @id @default(cuid())
  authorId       String
  targetUserId   String
  listingId      String?
  conversationId String?
  dealId         String?
  rating         Int
  tags           String[]
  text           String?       @db.Text
  replyText      String?       @db.Text
  repliedAt      DateTime?
  /// PUBLISHED | PENDING_MODERATION | DISPUTED — спорные не ломают публичный рейтинг до решения
  reviewModerationState String  @default("PUBLISHED")
  reviewStatus   ReviewStatus  @default(PUBLISHED)
  disputedAt     DateTime?
  isHidden       Boolean       @default(false)
  isDeleted      Boolean       @default(false)
  reportCount    Int           @default(0)
  riskScore      Int           @default(0)
  moderationNote String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  author     User         @relation("ReviewsGiven", fields: [authorId], references: [id], onDelete: Cascade)
  targetUser User         @relation("ReviewsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  listing    Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)
  deal       Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  reports    ReviewReport[]

  @@unique([authorId, targetUserId, listingId])
  @@index([targetUserId])
  @@index([authorId])
  @@index([listingId])
  @@index([conversationId])
  @@index([dealId])
  @@index([reviewStatus])
}

model Deal {
  id          String     @id @default(cuid())
  listingId   String
  listing     Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      User       @relation("DealSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User       @relation("DealBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  conversationId String?
  status      DealStatus @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  reviews     Review[]

  @@index([listingId])
  @@index([sellerId])
  @@index([buyerId])
  @@index([status])
}

model ReviewReport {
  id         String   @id @default(cuid())
  reviewId   String
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User     @relation("ReviewReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([reviewId, reporterId])
  @@index([reviewId])
  @@index([reporterId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
}

model Report {
  id                String           @id @default(cuid())
  listingId         String?
  listing           Listing?         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  targetUserId      String?
  targetUser        User?            @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  companyId         String?
  company           Company?         @relation("ReportCompany", fields: [companyId], references: [id], onDelete: Cascade)
  businessListingId String?
  businessListing   BusinessListing? @relation("ReportBusinessListing", fields: [businessListingId], references: [id], onDelete: Cascade)
  reason            String
  reportCategory    String?
  comment           String           @default("")
  status            String           @default("pending")
  createdAt         DateTime         @default(now())

  @@index([listingId])
  @@index([targetUserId])
  @@index([companyId])
  @@index([businessListingId])
  @@index([status])
}

enum ContentModerationSource {
  LISTING
  WANT_TO_BUY
  LISTING_UPLOAD
}

enum ContentModerationSeverity {
  BLOCKED
  FLAGGED
}

/// Автоматические срабатывания: запрещённый контент, дубли текста, отклонённые фото
model ContentModerationIncident {
  id           String                    @id @default(cuid())
  source       ContentModerationSource
  severity     ContentModerationSeverity
  userId       String
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId    String?
  listing      Listing?                  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  wantToBuyId  String?
  wantToBuy    WantToBuy?                @relation(fields: [wantToBuyId], references: [id], onDelete: SetNull)
  reasonCode   String
  summary      String
  matchedRules Json?
  payload      Json
  status       String                    @default("pending")
  reviewedAt   DateTime?
  staffId      String?
  staff        StaffAccount?             @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdAt    DateTime                  @default(now())

  @@index([status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([listingId])
  @@index([wantToBuyId])
}

model UploadedMediaFingerprint {
  id          String   @id @default(cuid())
  sha256      String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url         String
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  blocked     Boolean  @default(false)
  blockReason String?
  createdAt   DateTime @default(now())

  @@index([sha256])
  @@index([userId, createdAt(sort: Desc)])
  @@index([sha256, blocked])
}

