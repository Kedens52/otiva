  TURBO       // турбо-продвижение
}

enum PaidServiceStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model PaidService {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId   String
  listing     Listing           @relation(fields: [listingId], references: [id], onDelete: Cascade)
  serviceType PaidServiceType
  durationDays Int
  price       Int
  status      PaidServiceStatus @default(ACTIVE)
  startsAt    DateTime          @default(now())
  endsAt      DateTime
    createdAt   DateTime          @default(now())

  @@index([userId])
  @@index([listingId])
  @@index([status])
  @@index([endsAt])
}

enum SiteVisitType {
  PAGE_VIEW
  REGISTRATION
  LOGIN
}

/// Заходы и переходы по сайту (для админ-аналитики)
model SiteVisit {
  id          String        @id @default(cuid())
  type        SiteVisitType @default(PAGE_VIEW)
  path        String
  referrer    String?
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  visitorId   String
  fingerprint String
  ip          String?
  userAgent   String?
  createdAt   DateTime      @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([path, createdAt(sort: Desc)])
  @@index([visitorId, createdAt(sort: Desc)])
  @@index([fingerprint, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
}

// Трекинг уникальных просмотров по fingerprint (ip + userAgent hash)
model ListingView {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fingerprint String   // sha256(ip + userAgent)[0:16]
  createdAt   DateTime @default(now())

  @@unique([listingId, fingerprint])
  @@index([listingId])
}

/// Фиксация согласий с документами и политиками (152-ФЗ, оферта и т.д.)
