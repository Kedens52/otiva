  ARCHIVED
  BLOCKED
}

enum BusinessRequestStatus {
  DRAFT
  PENDING
  ACTIVE
  CLOSED
  ARCHIVED
  BLOCKED
}

/// Компания на B2B-площадке «Нашло Бизнес»
model Company {
  id                 String                    @id @default(cuid())
  ownerId            String
  owner              User                      @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  legalName          String?
  inn                String?
  ogrn               String?
  kpp                String?
  companyType        CompanyType               @default(LLC)
  businessRole       BusinessRole              @default(SUPPLIER)
  industry           String?
  description        String?
  region             String?
  city               String?
  address            String?
  websiteUrl         String?
  vkUrl              String?
  maxUrl             String?
  contactName        String?
  contactRole        String?
  contactPhone       String?
  contactEmail       String?
  verificationStatus CompanyVerificationStatus @default(PENDING_REVIEW)
  trustStatus        String                    @default("NORMAL")
  rejectionReason    String?
  isPublic           Boolean                   @default(false)
  isBlocked          Boolean                   @default(false)
  publicSlug         String?                   @unique
  logoUrl            String?
  coverUrl           String?
  shortDescription   String?
  catalogEnabled     Boolean                   @default(true)
  profileCompleteness Int                      @default(0)
  companyDeliveryRegions String[]              @default([])
  paymentTerms       String?
  vatType            String?
  minOrderInfo       String?
  showPhonePublicly  Boolean                   @default(false)
  showEmailPublicly  Boolean                   @default(false)
  showWebsitePublicly Boolean                  @default(true)
  showRequisitesPublicly Boolean               @default(false)
  showDocumentsPublicly Boolean                @default(false)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  members            CompanyMember[]
  listings           BusinessListing[]
  requests           BusinessRequest[]
  catalogCategories  BusinessCatalogCategory[]
  inquiriesReceived  BusinessInquiry[]         @relation("InquiryToCompany")
  conversations      Conversation[]            @relation("CompanyConversations")
  documents          CompanyDocument[]
  reviews            CompanyReview[]
  reports            Report[]                  @relation("ReportCompany")

  @@index([ownerId])
  @@index([verificationStatus])
  @@index([inn])
  @@index([isPublic, verificationStatus])
}

model CompanyMember {
  id        String            @id @default(cuid())
  companyId String
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CompanyMemberRole @default(VIEWER)
  invitedAt DateTime          @default(now())
  acceptedAt DateTime?

  @@unique([companyId, userId])
  @@index([userId])
}

model BusinessListing {
  id               String                @id @default(cuid())
  slug             String?               @unique
  companyId        String
  company          Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ownerId          String
  type             BusinessListingType
  category         String
  subcategory      String?
  title            String
  description      String
  price            Int                   @default(0)
  priceFrom        Int?
  priceTo          Int?
  priceType        String                @default("FIXED")
  priceUnit        String?
  minOrderQuantity Int?
  wholesalePrice   Int?
  wholesaleTiers   Json?
  availabilityStatus String?
  productionTime   String?
  deliveryTime     String?
  pickupAvailable  Boolean               @default(false)
  deliveryAvailable Boolean              @default(true)
  paymentTerms     String?
  vatType          String?
  catalogCategoryId String?
  catalogCategory  BusinessCatalogCategory? @relation(fields: [catalogCategoryId], references: [id], onDelete: SetNull)
  currency         String                @default("RUB")
  region           String?
  city             String?
  deliveryRegions  String[]              @default([])
  images           String[]              @default([])
  documents        String[]              @default([])
  attributes       Json?
  status           BusinessListingStatus @default(PENDING)
  rejectionReason  String?
  isPromoted       Boolean               @default(false)
  views            Int                   @default(0)
  inquiries        BusinessInquiry[]
  conversations    Conversation[]
  reports          Report[]              @relation("ReportBusinessListing")
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([companyId])
  @@index([ownerId])
  @@index([status, type])
  @@index([category, city])
  @@index([catalogCategoryId])
  @@index([createdAt(sort: Desc)])
}

enum CompanyDocumentType {
  CERTIFICATE
  LICENSE
  PRICE_LIST
  PRESENTATION
  OTHER
}

enum CompanyReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

model CompanyDocument {
  id        String              @id @default(cuid())
  companyId String
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title     String
  fileUrl   String
  docType   CompanyDocumentType @default(OTHER)
  isPublic  Boolean             @default(false)
  createdAt DateTime            @default(now())

  @@index([companyId, isPublic])
}

model CompanyReview {
  id        String              @id @default(cuid())
  companyId String
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  authorId  String
  author    User                @relation("CompanyReviewsAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  status    CompanyReviewStatus @default(PUBLISHED)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([companyId, authorId])
  @@index([companyId, status])
  @@index([authorId])
}

model BusinessCatalogCategory {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings BusinessListing[]

  @@unique([companyId, slug])
  @@index([companyId, sortOrder])
}

enum BusinessInquiryType {
  PRICE_REQUEST
  COMMERCIAL_OFFER
  WHOLESALE_REQUEST
  PARTNERSHIP
  CALLBACK
}

enum BusinessInquiryStatus {
  NEW
  IN_PROGRESS
  ANSWERED
  CLOSED
  SPAM
}

model BusinessInquiry {
  id                String              @id @default(cuid())
  fromUserId        String?
  fromUser          User?               @relation("BusinessInquiryFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)
  fromCompanyId     String?
  toCompanyId       String
  toCompany         Company             @relation("InquiryToCompany", fields: [toCompanyId], references: [id], onDelete: Cascade)
  businessListingId String?
  businessListing   BusinessListing?    @relation(fields: [businessListingId], references: [id], onDelete: SetNull)
  type              BusinessInquiryType @default(PRICE_REQUEST)
  contactName       String?
  contactCompany    String?
  quantity          String?
  city              String?
  message           String?
  contactPhone      String?
  contactEmail      String?
  status            BusinessInquiryStatus @default(NEW)
  conversation      Conversation?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([toCompanyId, status])
  @@index([fromUserId])
  @@index([createdAt(sort: Desc)])
}

/// Заявка на закупку (MVP: базовая модель)
model BusinessRequest {
  id          String                @id @default(cuid())
  companyId   String
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String
  category    String
  quantity    String?
  budgetFrom  Int?
  budgetTo    Int?
  region      String?
  city        String?
  deadline    DateTime?
  status      BusinessRequestStatus @default(PENDING)
  conversations Conversation[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([companyId])
  @@index([status])
}
