# Database
DATABASE_URL="postgresql://user:password@db-host:5432/nashlo"

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# App URLs
# Для production на сервере все публичные URL должны оставаться https://nashlo.ru
# В Next.js серверный .env.local имеет приоритет над .env.production во время build/start
# Не оставляйте localhost ни в одном production env-файле на сервере
APP_URL="https://nashlo.ru"
SITE_URL="https://nashlo.ru"
NEXT_PUBLIC_APP_URL="https://nashlo.ru"
NEXT_PUBLIC_SITE_URL="https://nashlo.ru"
# Legacy alias для старых OAuth-хелперов; можно оставить равным NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_BASE_URL="https://nashlo.ru"
NEXT_PUBLIC_APP_NAME="Nashlo"

# Webmaster verification
YANDEX_VERIFICATION="6eb4b0158e7865c6"
# Яндекс.Метрика (счётчик на публичных страницах)
NEXT_PUBLIC_YANDEX_METRIKA_ID="109258445"
GOOGLE_SITE_VERIFICATION=""

# IndexNow — ускорение индексации в Яндекс/Bing (файл public/{KEY}.txt создаётся при build)
INDEXNOW_KEY="nashlo_indexnow_2026_8f3a9c7b2d6e4f1a9b0c5d8e7a2f6c3"

# Maps
YANDEX_MAPS_API_KEY=
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# OAuth VK (https://id.vk.com) — для кнопки «Войти через VK» достаточно серверных переменных:
VK_CLIENT_ID="54574778"
NEXT_PUBLIC_VK_APP_ID="54574778"
VK_CLIENT_SECRET=""
# Redirect URI в кабинете VK должен совпадать (если пусто — {SITE_URL}/api/auth/vk/callback)
VK_REDIRECT_URI="https://nashlo.ru/api/auth/vk/callback"
# Опционально (только для встраиваемого VK ID SDK, не для кнопки входа):
# NEXT_PUBLIC_VK_APP_ID=""
# NEXT_PUBLIC_VK_REDIRECT_URI="https://nashlo.ru/api/auth/vk/callback"
# Доп. scope для oauth.vk.com/authorize (по умолчанию в коде: email)
# VK_OAUTH_SCOPE="email"

# OAuth Яндекс ID (https://oauth.yandex.ru/client/new)
YANDEX_CLIENT_ID="9f0ea463eae349df8d23323f494ce4bb"
YANDEX_CLIENT_SECRET=""
# Должен совпадать с Redirect URI в кабинете Яндекс (если пусто — {SITE_URL}/api/auth/yandex/callback)
YANDEX_REDIRECT_URI="https://nashlo.ru/api/auth/yandex/callback"
# По умолчанию: login:email login:info login:avatar
# YANDEX_OAUTH_SCOPE="login:email login:info login:avatar"

# Доп. доверенные host для CSRF админки (через запятую или пробел), если staging на другом домене
# ADMIN_CSRF_ALLOWED_HOSTS="staging.example.com"

# Admin access bootstrap values (server-only)
NASHLO_ADMIN_CODE=""
NASHLO_ADMIN_TOKEN=""

# SMS Provider (e.g. SMSC.ru)
SMS_API_KEY=""
SMS_SENDER=""

# Rate limit (OTP, регистрация) — общий счётчик для всех инстансов PM2
# REDIS_URL="redis://127.0.0.1:6379"

# Upload (Cloudinary or local)
UPLOAD_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# T-Bank Internet Acquiring (виджет СБП/T-Pay: docs/TBANK_SPEEDPAY.md)
# В ЛК: Магазины → Приём оплаты → Кнопки быстрой оплаты → включить СБП и др.
TBANK_TERMINAL_KEY=""
NEXT_PUBLIC_TBANK_TERMINAL_KEY=""
TBANK_PASSWORD=""
TBANK_API_TOKEN=""
TBANK_SUCCESS_URL="https://nashlo.ru/payment/success"
TBANK_FAIL_URL="https://nashlo.ru/payment/fail"
TBANK_NOTIFICATION_URL="https://nashlo.ru/api/payments/tbank/webhook"

# Web Push (браузерные уведомления; см. /profile/notifications → «Включить в этом браузере»)
# Сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:admin@nashlo.ru"
